# Browser settings
# Change this to your Chrome profile directory (e.g., Default, Profile 1, Person 1)
BROWSER_TYPE=chromium
CHROME_CHANNEL=chrome
BROWSER_HEADLESS=false
CHROME_PROFILE_DIR=/path/to/your/chrome/profile

# LLM settings for Ollama
# Make sure Ollama is running and the model is downloaded
LLM_PROVIDER=ollama/deepseek-r1:7b
LLM_API_BASE=http://127.0.0.1:11434
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_CHUNK_THRESHOLD=2000
LLM_OVERLAP_RATE=0.1

# LinkedIn URLs to crawl (comma-separated)
# Add the activity URLs you want to crawl
LINKEDIN_URLS=https://www.linkedin.com/in/username/recent-activity/all/ 